{
  "name": "sge-urbano",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de Gestão Energética Urbana",
  "main": "backend/src/server.js",
  "scripts": {
    "start": "node backend/src/server.js",
    "start:test": "node -e \"process.env.NODE_ENV='test';require('./backend/src/server')\"",
    "test:unit": "node --test",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "coverage": "nyc --reporter=text --reporter=html npm run test:unit"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "express": "^4.21.2",
    "express-session": "^1.18.1"
  },
  "devDependencies": {
    "cypress": "^15.0.0",
    "nyc": "^17.1.0"
  }
}
